{
  "hosting": [
    {
      "target": "securetrack",
      "public": "web-dashboard/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/SecureTrack-final.apk",
          "destination": "https://github.com/dhanushs602848/SecureTrack/releases/download/v1.8.0/SecureTrack-final.apk",
          "type": 302
        },
        {
          "source": "/SecureTrack.apk",
          "destination": "https://github.com/dhanushs602848/SecureTrack/releases/download/v1.8.0/SecureTrack-final.apk",
          "type": 302
        },
        {
          "source": "/download",
          "destination": "https://github.com/dhanushs602848/SecureTrack/releases/download/v1.8.0/SecureTrack-final.apk",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "legacy",
      "public": "web-dashboard/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/SecureTrack.apk",
          "destination": "https://github.com/dhanushs602848/SecureTrack/releases/download/v1.7/SecureTrack.apk",
          "type": 302
        },
        {
          "source": "/download",
          "destination": "https://github.com/dhanushs602848/SecureTrack/releases/download/v1.7/SecureTrack.apk",
          "type": 302
        },
        {
          "source": "/:path*",
          "destination": "https://track-99c90-track.web.app/:path",
          "type": 301
        },
        {
          "source": "/",
          "destination": "https://track-99c90-track.web.app",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}

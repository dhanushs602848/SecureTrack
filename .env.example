# SecureTrack Environment Variables Configuration Template

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/securetrack_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Security JWT Secret Key (Required: Min 256-bit / 32-byte secret key)
# DO NOT COMMIT REAL SECRETS. Set JWT_SECRET in your environment or production settings.
JWT_SECRET=YOUR_SECURE_RANDOM_256_BIT_SECRET_KEY_GOES_HERE

# Spring Mail Credentials (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# React Web Dashboard Endpoint
VITE_API_URL=http://localhost:8080/api

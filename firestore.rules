rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for multi-device & multi-user ownership and security
    function isAuthenticated() {
      return request.auth != null;
    }

    function isHumanOwner(userId) {
      return isAuthenticated() &&
             request.auth.uid == userId &&
             (!('role' in request.auth.token) || (request.auth.token.role != 'device' && request.auth.token.role != 'revoked')) &&
             (!('revoked' in request.auth.token) || request.auth.token.revoked != true);
    }

    function isDeviceActive(userId, deviceId) {
      return get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)).data.status != 'REVOKED';
    }

    function isAuthorizedDevice(userId, deviceId) {
      return isAuthenticated() &&
             isDeviceActive(userId, deviceId) &&
             (
               // Spark-compatible Anonymous/Auth device identity:
               get(/databases/$(database)/documents/users/$(userId)/devices/$(deviceId)).data.deviceAuthUid == request.auth.uid ||
               // Cloud Function custom token identity (future server option):
               (('role' in request.auth.token) && request.auth.token.role == 'device' && request.auth.token.ownerUid == userId && request.auth.token.deviceId == deviceId)
             );
    }

    match /users/{userId} {
      // User root document is accessible only by the authenticated human owner
      allow read, write: if isHumanOwner(userId);

      match /devices/{deviceId} {
        // Read: Human owner can read all devices. Authorized device can read its own document.
        allow read: if isHumanOwner(userId) || isAuthorizedDevice(userId, deviceId);

        // Create & Delete: Restricted strictly to the human owner
        allow create: if isHumanOwner(userId);
        allow delete: if isHumanOwner(userId);

        // Update:
        // - Owner has full update capability.
        // - Authorized device can ONLY update an explicit allowlist of telemetry fields.
        // - Identity, ownership, pairing and protection-control fields are strictly immutable to devices.
        // - Devices cannot set their own status to REVOKED or anything other than explicit telemetry status (ONLINE/OFFLINE).
        allow update: if isHumanOwner(userId) || (
          isAuthorizedDevice(userId, deviceId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'batteryLevel', 'lastSeen', 'locationStatus', 'trackingStatus', 'networkStatus', 'status',
            'locationPermission', 'bluetoothStatus', 'bluetoothPermission', 'protectionStatus',
            'protectionReason', 'protectionEnabled',
            'lastLatitude', 'lastLongitude', 'locationAccuracy', 'lastAccuracy', 'locationSource', 'locationTimestamp', 'lastRequestId'
          ]) &&
          request.resource.data.status in ['ONLINE', 'OFFLINE']
        );

        match /locations/{locationId} {
          allow read: if isHumanOwner(userId) || isAuthorizedDevice(userId, deviceId);
          allow create: if (isHumanOwner(userId) || isAuthorizedDevice(userId, deviceId)) &&
                        request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0 &&
                        request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0 &&
                        (!('accuracy' in request.resource.data) || request.resource.data.accuracy >= 0);
          allow update, delete: if isHumanOwner(userId);
        }

        match /commands/{commandId} {
          allow read: if isHumanOwner(userId) || isAuthorizedDevice(userId, deviceId);
          // ONLY human owner can create or delete commands
          allow create: if isHumanOwner(userId);
          allow delete: if isHumanOwner(userId);

          // Update: Owner can update, or active device can ONLY update execution status/result fields
          // Device cannot alter command identity, target ID, requesting user, or command type/payload
          allow update: if isHumanOwner(userId) || (
            isAuthorizedDevice(userId, deviceId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'result', 'executedAt', 'error', 'details', 'progress', 'requestId'
            ]) &&
            request.resource.data.status in ['RECEIVED', 'ACKNOWLEDGED', 'EXECUTING', 'EXECUTED', 'FAILED', 'EXPIRED'] &&
            (!('targetDeviceId' in resource.data) || request.resource.data.targetDeviceId == resource.data.targetDeviceId) &&
            (!('command' in resource.data) || request.resource.data.command == resource.data.command) &&
            (!('commandType' in resource.data) || request.resource.data.commandType == resource.data.commandType) &&
            (!('payload' in resource.data) || request.resource.data.payload == resource.data.payload)
          );
        }
      }

      match /private_recovery/{deviceId} {
        // Highly sensitive IMEI and recovery credentials: ONLY the human owner
        allow read, write: if isHumanOwner(userId);
      }

      match /alerts/{alertId} {
        allow read: if isHumanOwner(userId);
        // Human owner or any active authorized device owned by this user can create security alerts
        allow create: if isHumanOwner(userId) || (
          isAuthenticated() &&
          (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == userId) &&
          isAuthorizedDevice(userId, request.resource.data.deviceId)
        );
        allow update: if (isHumanOwner(userId) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status', 'dismissedAt', 'dismissedBy', 'resolvedAt'
                      ]) &&
                      request.resource.data.status in ['ACTIVE', 'ACKNOWLEDGED', 'RESOLVED', 'DISMISSED']) ||
                      (isAuthenticated() &&
                      isAuthorizedDevice(userId, resource.data.deviceId) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'executionStatus', 'completedAt'
                      ]) &&
                      request.resource.data.executionStatus in ['STARTED', 'COMPLETED']);
        allow delete: if isHumanOwner(userId);
      }

      match /safe_zones/{zoneId} {
        allow read, write: if isHumanOwner(userId);
      }
    }

    // Spark-Compatible One-Time Pairing Invitations
    match /pairing_invitations/{tokenHash} {
      // Get: Any authenticated user who knows the 256-bit token hash can inspect the invitation
      allow get: if isAuthenticated();

      // List: Authenticated owners can list their own invitations, or claimants can find invitations claimed by them
      allow list: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || resource.data.claimedByUid == request.auth.uid);

      // Create: Only authenticated human owner
      allow create: if isAuthenticated() &&
                    request.resource.data.ownerUid == request.auth.uid &&
                    request.resource.data.status == 'PENDING_CLAIM' &&
                    request.resource.data.expiresAt > request.time;

      // Update:
      // 1. Claimant transitions PENDING_CLAIM -> PENDING_APPROVAL with device info
      // 2. Owner approves (-> APPROVED) or rejects (-> REJECTED)
      allow update: if (
        // Case 1: Claimant claims invitation
        (
          resource.data.status == 'PENDING_CLAIM' &&
          request.time < resource.data.expiresAt &&
          request.resource.data.status == 'PENDING_APPROVAL' &&
          request.resource.data.claimedByUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.expiresAt == resource.data.expiresAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'claimedByUid', 'claimedDeviceId', 'deviceInfo', 'claimedAt'
          ])
        ) ||
        // Case 2: Owner approves or rejects
        (
          isAuthenticated() &&
          request.auth.uid == resource.data.ownerUid &&
          (request.resource.data.status == 'APPROVED' || request.resource.data.status == 'REJECTED')
        )
      );

      // Delete: Only owner
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // Legacy pairing codes collection:
    // Clients cannot read or list pairing codes directly to prevent enumeration/theft.
    match /pairing_codes/{codeHash} {
      allow read, write: if false;
    }

    // Rate limiting tracking collection:
    // Managed exclusively by Cloud Functions
    match /pairing_rate_limits/{hash} {
      allow read, write: if false;
    }
  }
}

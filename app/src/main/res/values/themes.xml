<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (LIGHT) -->
    <style name="Base.Theme.SecureTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/electric_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_blue</item>
        <item name="colorOnPrimaryContainer">@color/electric_blue</item>
        <item name="colorSecondary">@color/electric_violet</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:navigationBarColor">@color/bg_app</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- High-visibility text input defaults -->
        <item name="android:editTextColor">@color/input_text</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="textInputStyle">@style/Widget.SecureTrack.TextInputLayout</item>
        <item name="editTextStyle">@style/Widget.SecureTrack.EditText</item>
    </style>

    <style name="Theme.SecureTrack" parent="Base.Theme.SecureTrack" />

    <!-- Card Style -->
    <style name="Widget.SecureTrack.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/border_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Global High-Visibility TextInputLayout Style -->
    <style name="Widget.SecureTrack.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="boxStrokeColor">@color/input_focus_border</item>
        <item name="hintTextColor">@color/input_label</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- Global High-Visibility EditText Style -->
    <style name="Widget.SecureTrack.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/input_text</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>

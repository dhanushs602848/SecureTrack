<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.SecureTrack.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cmd_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:textColor="@color/primary_navy"
                android:textSize="14.5sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.01"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="LOCATE_NOW" />

            <TextView
                android:id="@+id/tv_cmd_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_info"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/primary_blue"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:includeFontPadding="false"
                tools:text="EXECUTED" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_cmd_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:letterSpacing="0.005"
            tools:text="Instant location request dispatched" />

        <TextView
            android:id="@+id/tv_cmd_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.01"
            android:visibility="gone"
            tools:text="Nov 19, 2026 • 23:42" />

    </LinearLayout>
</androidx.cardview.widget.CardView>

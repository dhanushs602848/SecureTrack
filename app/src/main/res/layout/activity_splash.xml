<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:gravity="center"
    tools:ignore="HardcodedText">

    <!-- Center Logo & Radar Container -->
    <RelativeLayout
        android:id="@+id/layout_logo_container"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="160dp">

        <!-- Expanding Radar Ring 2 -->
        <View
            android:id="@+id/radar_ring_2"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_centerInParent="true"
            android:alpha="0"
            android:background="@drawable/radar_pulse_ring" />

        <!-- Expanding Radar Ring 1 -->
        <View
            android:id="@+id/radar_ring_1"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_centerInParent="true"
            android:alpha="0"
            android:background="@drawable/radar_pulse_ring" />

        <!-- Ambient Glow behind Shield -->
        <View
            android:id="@+id/view_logo_glow"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_centerInParent="true"
            android:alpha="0"
            android:background="@drawable/bg_logo_glow" />

        <!-- Core Shield Logo -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_centerInParent="true"
            android:alpha="0"
            android:contentDescription="@string/app_name"
            android:scaleX="0.5"
            android:scaleY="0.5"
            android:src="@drawable/ic_shield_logo" />
    </RelativeLayout>

    <!-- Brand Typography Container -->
    <LinearLayout
        android:id="@+id/layout_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout_logo_container"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:alpha="0"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_brand_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="SECURETRACK"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.04"
            android:text="Smart Protection. Smarter Tracking."
            android:textColor="#94A3B8"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bottom Pulse Indicator & Footer -->
    <LinearLayout
        android:id="@+id/layout_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:alpha="0"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progress_splash"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="MULTI-DEVICE SECURITY SUITE"
            android:textColor="#475569"
            android:textSize="11sp"
            android:letterSpacing="0.12" />
    </LinearLayout>

</RelativeLayout>
